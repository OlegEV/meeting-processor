# API Keys - копируйте этот файл в .env и заполните своими ключами

# Deepgram API Key для транскрипции аудио
# Получите на https://deepgram.com
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Claude API Key (через OpenRouter)
# Получите на https://openrouter.ai
CLAUDE_API_KEY=your_claude_api_key_here

# Confluence API Token (опционально, для интеграции с Confluence)
CONFLUENCE_API_TOKEN=your_confluence_api_token_here

# PostgreSQL (опционально). По умолчанию приложение работает с SQLite (config.json → database).
# DATABASE_URL включает PostgreSQL и перекрывает раздел database из config.json:
# DATABASE_URL=postgresql://meeting:password@localhost:5432/meeting_processor
# Либо параметры подключения задаются в config.json, а пароль — здесь:
# DATABASE_PASSWORD=your_database_password_here
# Пароль для контейнера PostgreSQL из docker-compose (профиль postgres):
# POSTGRES_PASSWORD=your_database_password_here

# Локальная разработка: отключить проверку JWT-токенов и использовать debug-пользователя.
# Перекрывает auth.debug_mode из config.json. В прод не выставлять.
# Truthy: 1, true, yes, on (регистронезависимо). Любое другое значение — выключено.
# AUTH_DEBUG_MODE=true
